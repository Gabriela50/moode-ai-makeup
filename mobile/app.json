{
  "expo": {
    "name": "MOODÉ",
    "slug": "moode",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gabriela.moode"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "Tu espacio personal de belleza y maquillaje",
    "extra": {
      "eas": {
        "projectId": "f027dd41-b15d-4a18-860f-4e1fcc07f174"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MOODÉ necesita acceso a la cámara para capturar tu fotografía."
        }
      ],
      "./plugins/withMoodeWeb"
    ]
  }
}
